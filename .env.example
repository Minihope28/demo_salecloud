# Mode : mock (démonstration, Salesforce simulé) ou live (vraie org Salesforce)
APP_MODE=mock

# Obligatoire en live : longue chaîne aléatoire (ex. python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=

# --- Salesforce (mode live) ---
# Sandbox : https://test.salesforce.com   Production : https://login.salesforce.com   ou le My Domain de Volvo
SF_LOGIN_URL=https://test.salesforce.com
# Consumer Key de l'application connectée (Connected App / External Client App) créée par l'admin Salesforce
SF_CLIENT_ID=
# Consumer Secret : facultatif si l'application est configurée en client public avec PKCE
SF_CLIENT_SECRET=
# Doit être identique à l'URL de rappel déclarée dans l'application connectée
SF_REDIRECT_URI=https://dossier-client.exemple.volvo.internal/auth/callback
SF_API_VERSION=v62.0

# --- Divers ---
DATA_DIR=./data
FIELD_MAPPING_PATH=./config/field_mapping.json
COOKIE_SECURE=true
DRAFT_RETENTION_DAYS=14
MAX_UPLOAD_MB=8
MAX_PDF_PAGES=40
# OCR (lecture des PDF scannés ou mal encodés) : auto = utilisé si Tesseract est installé ; on ; off
OCR=auto
# Chemin de tesseract.exe s'il n'est pas trouvé automatiquement (Windows : C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
OCR_LANG=fra
# Référentiel officiel des codes postaux (Barid Al-Maghrib, data.gov.ma), CSV ou XLSX
POSTAL_CODES_PATH=./config/codes_postaux.csv
# Boutons « Exemple fictif » (true par défaut en mock, false en live)
DEMO_SAMPLES=false
